rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMjcEmail() {
      return request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@mjc[.]ac[.]kr$');
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin/users)
        && get(/databases/$(database)/documents/admin/users)
            .data.uids.hasAny([request.auth.uid]);
    }

    // 관리자 화이트리스트 (Firebase 콘솔에서만 직접 관리)
    match /admin/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && isMjcEmail();
    }

    // 공지: 누구나 읽기. 사용자는 reports_count 증가만 허용. 그 외 필드(summary 등)는 관리자만.
    match /notices/{board}/posts/{pid} {
      allow read: if true;
      allow update: if (
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['reports_count'])
      ) || isAdmin();
      allow create, delete: if isAdmin();
    }

    // 공지/메타 등 그 외 notices/** 경로는 관리자만 쓰기 (서버 크롤러는 admin SDK 라 룰 무시)
    match /notices/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CTL/MPU(핵심역량) 공지/프로그램: 앱에서 읽기만 사용.
    // NOTE: 실제 데이터 쓰기는 크롤러/관리자(Admin SDK)에서 수행.
    match /ctl_data/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /core_competencies/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사용자 신고: 누구나 create, 관리자만 read/update.
    match /notice_reports/{rid} {
      allow create: if request.resource.data.keys()
        .hasAll(['board_id', 'post_id', 'reason', 'status']);
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 개발자 문의: 누구나 create, 관리자만 read/update.
    match /developer_inquiries/{iid} {
      allow create: if request.resource.data.keys()
        .hasAll(['type', 'message', 'status']);
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 개발 로그 (테스트 빌드용): 누구나 읽기, 관리자만 쓰기.
    match /dev_logs/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 앱 정적 데이터/설정: 누구나 읽기. 쓰기는 관리자만.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 셔틀/학식/시간표 등: 누구나 읽기. 쓰기는 관리자만.
    match /shuttle_schedule/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /foodcourt_menu/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /timetable_official/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
