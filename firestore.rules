rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMjcEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@mjc[.]ac[.]kr$');
    }

    function isSignedInMjc() {
      return request.auth != null && isMjcEmail();
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin/users)
        && get(/databases/$(database)/documents/admin/users)
            .data.uids.hasAny([request.auth.uid]);
    }

    function isReportCountIncrement() {
      return isSignedInMjc()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['reports_count'])
        && request.resource.data.reports_count is int
        && (
          (
            !resource.data.keys().hasAny(['reports_count'])
            && request.resource.data.reports_count == 1
          )
          || (
            resource.data.reports_count is int
            && request.resource.data.reports_count == resource.data.reports_count + 1
          )
        );
    }

    function isValidNoticeReportCreate() {
      return isSignedInMjc()
        && request.resource.data.keys().hasOnly([
          'board_id',
          'post_id',
          'post_title',
          'post_url',
          'reason',
          'reason_label',
          'comment',
          'platform',
          'created_at',
          'status'
        ])
        && request.resource.data.board_id is string
        && request.resource.data.board_id.size() > 0
        && request.resource.data.board_id.size() <= 100
        && request.resource.data.post_id is string
        && request.resource.data.post_id.size() > 0
        && request.resource.data.post_id.size() <= 200
        && request.resource.data.reason is string
        && request.resource.data.reason in [
          'summary_wrong',
          'body_truncated',
          'body_missing',
          'other'
        ]
        && request.resource.data.reason_label is string
        && request.resource.data.reason_label.size() <= 100
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 40
        && request.resource.data.post_title is string
        && request.resource.data.post_title.size() <= 300
        && request.resource.data.post_url is string
        && request.resource.data.post_url.size() <= 1000
        && request.resource.data.created_at == request.time
        && request.resource.data.status == 'open';
    }

    function isValidDeveloperInquiryCreate() {
      return isSignedInMjc()
        && request.resource.data.keys().hasOnly([
          'type',
          'type_label',
          'message',
          'contact',
          'device_info',
          'created_at',
          'status',
          'admin_memo',
          'resolved_by',
          'resolved_at'
        ])
        && request.resource.data.type is string
        && request.resource.data.type in [
          'bug',
          'suggestion',
          'general',
          'other'
        ]
        && request.resource.data.type_label is string
        && request.resource.data.type_label.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 3000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 200
        && request.resource.data.device_info is map
        && request.resource.data.device_info.keys().hasOnly(['platform'])
        && request.resource.data.device_info.platform is string
        && request.resource.data.device_info.platform.size() <= 40
        && request.resource.data.created_at == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.admin_memo == ''
        && request.resource.data.resolved_by == null
        && request.resource.data.resolved_at == null;
    }

    // 관리자 화이트리스트 (Firebase 콘솔에서만 직접 관리)
    match /admin/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && isMjcEmail();
    }

    // 공지: 누구나 읽기. 로그인한 MJC 사용자는 reports_count +1만 허용. 그 외 필드는 관리자만.
    match /notices/{board}/posts/{pid} {
      allow read: if true;
      allow update: if isReportCountIncrement() || isAdmin();
      allow create, delete: if isAdmin();
    }

    // 공지/메타 등 그 외 notices/** 경로는 관리자만 쓰기 (서버 크롤러는 admin SDK 라 룰 무시)
    match /notices/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CTL/MPU(핵심역량) 공지/프로그램: 앱에서 읽기만 사용.
    // NOTE: 실제 데이터 쓰기는 크롤러/관리자(Admin SDK)에서 수행.
    match /ctl_data/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /core_competencies/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사용자 신고: 로그인한 MJC 사용자만 정해진 형식으로 create, 관리자만 read/update.
    match /notice_reports/{rid} {
      allow create: if isValidNoticeReportCreate();
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 개발자 문의: 로그인한 MJC 사용자만 정해진 형식으로 create, 관리자만 read/update.
    match /developer_inquiries/{iid} {
      allow create: if isValidDeveloperInquiryCreate();
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 개발 로그 (테스트 빌드용): 관리자만 읽기/쓰기.
    match /dev_logs/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // 앱 정적 데이터/설정: 누구나 읽기. 쓰기는 관리자만.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 셔틀/학식/시간표 등: 누구나 읽기. 쓰기는 관리자만.
    match /shuttle_schedule/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /foodcourt_menu/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /timetable_official/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 학과 공지 (실험): 읽기 공개, 쓰기 관리자만.
    match /community_notices/{deptSlug} {
      allow read: if true;
      allow write: if isAdmin();
      match /meta/{doc} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /posts/{postId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }
  }
}
